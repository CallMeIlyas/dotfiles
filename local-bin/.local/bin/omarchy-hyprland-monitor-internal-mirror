#!/usr/bin/env bash

# omarchy:summary=Enable, disable, toggle, or recover mirroring high-res external monitor to laptop screen
# omarchy:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/omarchy/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"
FIX_SCRIPT="$HOME/.config/hypr/scripts/fix-workspaces.sh"

INTERNAL=$(omarchy-hyprland-monitor-laptop 2>/dev/null || echo "eDP-1")
EXTERNAL=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name' | head -n 1)

on() {
  if [[ -z $EXTERNAL ]]; then
    omarchy-notification-send -g 󰍹 "No external monitors found for mirror"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    omarchy-notification-send -g 󰍹 "No laptop monitor found to mirror"
    exit 1
  fi

  omarchy-hyprland-toggle $DISABLE_TOGGLE off 2>/dev/null || true

  if omarchy-hyprland-toggle-disabled $TOGGLE; then
    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' "$INTERNAL" "$EXTERNAL" >"$TOGGLE_FLAG"
    omarchy-notification-send -g 󰍹 "Mirroring enabled"
    hyprctl reload
  fi
}

off() {
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    omarchy-hyprland-toggle $TOGGLE off
    omarchy-notification-send -g 󰍹 "Extended mode restored"
    hyprctl reload
    sleep 0.5
    if [ -x "$FIX_SCRIPT" ]; then
      "$FIX_SCRIPT" >/dev/null 2>&1
    fi
  fi
}

toggle() {
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    off
  else
    on
  fi
}

recover() {
  if ! omarchy-hyprland-monitor-external-active && omarchy-hyprland-toggle-enabled $TOGGLE; then
    omarchy-hyprland-toggle $TOGGLE off
    hyprctl reload
    sleep 0.5
    if [ -x "$FIX_SCRIPT" ]; then
      "$FIX_SCRIPT" >/dev/null 2>&1
    fi
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
